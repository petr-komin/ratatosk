# Lokální vývoj — zkopíruj na .env:  cp .env.dev.example .env
# Liší se od .env.example jen v DB, APP_URL a vypnuté secure cookie.

# Port lokálního serveru. Musí sedět s APP_URL.
DEV_PORT=8099
APP_URL=http://localhost:8099
INVITE_CODE=dev
SESSION_SECURE=0
APP_TIMEZONE=Europe/Prague

# Postgres z compose.dev.yml
DB_HOST=db
DB_PORT=5432
DB_NAME=ratatosk
DB_USER=ratatosk
DB_PASSWORD=dev

# R2 — bez těchhle údajů projde všechno kromě samotného uploadu.
# V CORS policy bucketu musí být origin http://localhost:8099 (viz README).
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=ratatosk
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BASE_URL=https://videa.example.com
UPLOAD_URL_TTL=3600
DELETE_SOURCE_AFTER_TRANSCODE=0

FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
FFMPEG_AUDIO_BITRATE=128k
