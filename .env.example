# ---------------------------------------------------------------------------
# Ratatosk — konfigurace. Zkopíruj na .env a vyplň.
# ---------------------------------------------------------------------------

# Veřejná URL aplikace (bez lomítka na konci). Používá se pro sdílecí odkazy.
APP_URL=https://ratatosk.example.com

# Kód, který musí znát ten, kdo si zakládá účet. Registrace je jinak zavřená.
# Vygeneruj třeba: openssl rand -hex 16
INVITE_CODE=zmen-me

# secure cookie -> zapni jakmile jedeš přes HTTPS
SESSION_SECURE=1

# --- PostgreSQL (běží na hostu, mimo Docker) -------------------------------
# Z kontejneru se na host dostaneš přes host.docker.internal
# (docker-compose.yml na to má extra_hosts).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ratatosk
DB_USER=ratatosk
DB_PASSWORD=

# --- Cloudflare R2 ---------------------------------------------------------
# Stačí account id (najdeš v URL dashboardu nebo v R2 → API).
# Endpoint se z něj složí sám; R2_ENDPOINT vyplň, jen když potřebuješ jiný.
R2_ACCOUNT_ID=
R2_ENDPOINT=

# Bucket musí existovat — appka ho nezaloží.
R2_BUCKET=ratatosk
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Veřejná doména napojená na TENHLE bucket (bez lomítka na konci).
# Odsud se přehrává hotové MP4. Doména je vždycky vázaná na jeden konkrétní
# bucket, takže ji nelze sdílet s jiným — každý bucket chce svoji.
R2_PUBLIC_BASE_URL=https://videa.example.com

# Platnost presigned PUT URL pro upload (sekundy).
UPLOAD_URL_TTL=3600

# Smazat zdrojové WebM po úspěšném překódování? 1 = smazat, 0 = nechat jako zálohu.
DELETE_SOURCE_AFTER_TRANSCODE=0

# --- ffmpeg ----------------------------------------------------------------
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
FFMPEG_AUDIO_BITRATE=128k
